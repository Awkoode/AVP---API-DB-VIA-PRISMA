generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Equipe {
  id              Int             @id @default(autoincrement())
  nome            String
  especialidade   String
  desenvolvedores Desenvolvedor[]
}

model Desenvolvedor {
  id       Int    @id @default(autoincrement())
  nome     String
  nivel    String
  equipeId Int
  equipe   Equipe @relation(fields: [equipeId], references: [id])
}